{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS 11 app (CommonJS via NodeNext, decorators)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolvePackageJsonExports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": false,
    "sourceMap": true,
    "incremental": true,
    "removeComments": true,
    "outDir": "${configDir}/dist",
    "types": ["node"]
  }
}
