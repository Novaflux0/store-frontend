# Normalise line endings so Windows and Unix contributors produce identical diffs.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.glb binary
*.ktx2 binary
*.wasm binary
*.woff binary
*.woff2 binary
*.pdf binary
*.docx binary
*.zip binary
