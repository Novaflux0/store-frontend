{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@agency/config-typescript/nextjs.json",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "scripts",
    ".next/types/**/*.ts",
    "*.config.ts",
    "*.config.mts",
    "vitest.setup.ts",
    "test"
  ],
  "exclude": ["node_modules"]
}
