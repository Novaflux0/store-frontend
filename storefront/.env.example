# storefront (@agency/storefront) environment. Copy to `.env` (or `.env.local`) for local development.
# Validated with Zod: src/lib/env/server.ts and src/lib/env/client.ts.

# --- Server only (never sent to the browser) --------------------------------
# Origin of the NestJS API, without the /api/v1 prefix (apiPath() adds it).
API_BASE_URL=http://localhost:4000
# Shared with the backend (ADR 0006). At least 32 characters; must equal the API's value.
CLIENT_IP_HMAC_SECRET=local-dev-only-change-me-0123456789abcdef
# Optional: secret a Cloudflare Transform Rule sends as `x-edge-auth` (ADR 0006).
# Only with it is CF-Connecting-IP trusted; leave empty locally.
EDGE_AUTH_SECRET=

# Shared with the backend: verifies the signed revalidation requests the API sends
# after a publish (POST /api/revalidate). At least 32 characters; must equal
# REVALIDATE_HMAC_SECRET in backend/.env. Required on Vercel builds.
REVALIDATE_HMAC_SECRET=local-dev-only-revalidate-secret-0123456789

# Feature flags (@agency/config). Off unless set to true/1/on/yes.
FEATURE_CLIENT_PORTAL=false

# --- Public (inlined into the browser bundle at build time) -----------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser-facing API origin, used for the CSP connect-src.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# Object storage origin that receives presigned CV uploads (CSP connect-src). Local:
# MinIO from infra/docker. Production: the R2 S3 endpoint, e.g.
# https://<account-id>.r2.cloudflarestorage.com. Must equal the origin of the
# `uploadUrl` the API returns. Required on Vercel preview and production builds.
NEXT_PUBLIC_UPLOAD_ORIGIN=http://localhost:9000
# Origin of the public CMS images (ADR 0017), allowed in next/image and the CSP
# img-src. Local: MinIO. Production: the media custom domain, e.g. https://media.agency.com
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:9000
# Cloudflare Turnstile test key that always passes. The API must use the matching
# test secret locally (TURNSTILE_SECRET in backend/.env.example).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
